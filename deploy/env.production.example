# Production .env for the cloud VPS.  Copy to:  server/.env
# The app binds to localhost only; Nginx terminates HTTPS on 443 and proxies to it.

EMP_DEPLOYMENT_MODEL=cloud_vps

# Bind to loopback — never expose 8084 directly to the internet (Nginx fronts it).
EMP_HOST=127.0.0.1
EMP_PORT=8084

# The address customers/agents actually use. No port here (Nginx serves on 443).
# Agents and license keys embed exactly this URL, so it MUST be the public HTTPS domain.
EMP_SERVER_PUBLIC_URL=https://vmgmt.voyage.co.in

# Production database (recommended over the bundled SQLite):
# EMP_DATABASE_URL=postgresql+psycopg2://vmgmt:CHANGE_ME@localhost:5432/vmgmt

# Optional hardening
EMP_REQUIRE_MFA=false
EMP_ACCESS_TOKEN_MINUTES=60

# SMTP can be set here or in the console (Settings -> Email setup):
# EMP_SMTP_HOST=smtp.gmail.com
# EMP_SMTP_PORT=587
# EMP_SMTP_USER=support@voyager.co.in
# EMP_SMTP_PASSWORD=your-16-char-app-password
# EMP_SMTP_FROM=support@voyager.co.in
# EMP_SMTP_FROM_NAME=Voyager Endpoint Management
