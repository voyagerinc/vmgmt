# Production .env for the cloud license server VPS.  Copy to:  server/.env

EMP_DEPLOYMENT_MODEL=cloud_vps

# The license server listens directly on port 8084 (client servers use 9084 on their own LAN).
EMP_HOST=0.0.0.0
EMP_PORT=8084

# The address customers, client servers and agents use. License files (.lic), customer emails
# and downloaded agents embed exactly this URL.
EMP_SERVER_PUBLIC_URL=http://vmgmt.voyager.co.in:8084

# Leave EMP_LICENSE_SERVER unset here: this server IS the license server.

# Production database (recommended over the bundled SQLite):
# EMP_DATABASE_URL=postgresql+psycopg2://vmgmt:CHANGE_ME@localhost:5432/vmgmt

# Optional hardening
EMP_REQUIRE_MFA=false
EMP_ACCESS_TOKEN_MINUTES=60

# SMTP can be set here or in the console (Settings -> Email setup):
# EMP_SMTP_HOST=smtp.gmail.com
# EMP_SMTP_PORT=587
# EMP_SMTP_USER=support@voyager.co.in
# EMP_SMTP_PASSWORD=your-16-char-app-password
# EMP_SMTP_FROM=support@voyager.co.in
# EMP_SMTP_FROM_NAME=Voyager Endpoint Management
