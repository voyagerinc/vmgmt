# Copy to server/.env to override defaults. All keys are prefixed EMP_.
# Deployment model: on_premise | cloud_vps | hybrid | central_saas
EMP_DEPLOYMENT_MODEL=on_premise
EMP_SERVER_PUBLIC_URL=http://127.0.0.1:8084
EMP_HOST=127.0.0.1
EMP_PORT=8084

# Production database (leave unset to use the bundled SQLite file):
# EMP_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/management

# Security (leave unset to auto-generate stable keys under server/data/):
# EMP_SECRET_KEY=change-me-long-random
# EMP_EVIDENCE_KEY=<fernet-key>
EMP_REQUIRE_MFA=false
EMP_ACCESS_TOKEN_MINUTES=60

# Agent / telemetry
EMP_HEARTBEAT_INTERVAL_SECONDS=60
EMP_OFFLINE_AFTER_SECONDS=300

# Retention (PRD §24.2)
EMP_DEFAULT_EVIDENCE_RETENTION_DAYS=30
EMP_DEFAULT_EVENT_RETENTION_DAYS=90
